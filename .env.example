# App
APP_NAME=KEIVerse
APP_VERSION=1
PORT=5000 # Default PORT
NODE_ENV= # development | production

# Cors
CORS_ORIGIN= # frontend domain

# Database
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<service_name>:<POSTGRES_PORT>/<POSTGRES_DB>
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=ilms_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=86400 # 24h

# Auth
SALT_ROUNDS=10 # bcrypt
JWT_ACCESS_SECRET=your_access_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logger
LOKI_HOST=http://loki:3100 # http://gateway:3100
LOG_TRANSPORT= # file | loki | both

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USERNAME=
MINIO_PASSWORD=
MINIO_BUCKET=keiverse
MINIO_PUBLIC_URL=http://minio:9000

# Storage
STORAGE_DRIVER= # local | minio

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
