# App
APP_NAME=InteractiveLMS
APP_VERSION=1
PORT=5000 # Default PORT
NODE_ENV=development # development | production

# Cors
CORS_ORIGIN=http://localhost:3000 # frontend domain

# Domain & Traefik (Deployment / Proxy)
APP_DOMAIN=localhost
MINIO_DOMAIN=files.localhost
ACME_EMAIL=admin@example.com
DESEC_TOKEN=

# Database (Local: localhost:5432 | Docker: tự động override sang postgres:5432)
DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/ilms_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=ilms_db
POSTGRES_PORT=5432

# Redis (Local: localhost | Docker: tự động override sang redis:6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_TTL=86400 # 24h

# Auth
SALT_ROUNDS=10 # bcrypt
JWT_ACCESS_SECRET=your_access_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_TEMP_SECRET=your_google_temp_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_TEMP_EXPIRES_IN=10m

# Logger
LOKI_HOST=http://localhost:3101 # http://gateway:3100 trong docker
LOG_TRANSPORT=file # file | loki | both

# MinIO (Local: localhost:9090 | Docker: tự động override sang minio:9000)
MINIO_INTERNAL_ENDPOINT=localhost
MINIO_PORT=9090
MINIO_CONSOLE_PORT=9001
MINIO_USERNAME=your_minio_user
MINIO_PASSWORD=your_minio_password
MINIO_BUCKET=ilms-bucket
MINIO_PUBLIC_ENDPOINT=localhost:9090
MINIO_USE_SSL=false

# Storage
STORAGE_DRIVER=minio # local | minio

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Notification: Email (Optional / SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=noreply@ilms.local

# Notification: SMS (Optional / Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_PHONE=+1234567890
